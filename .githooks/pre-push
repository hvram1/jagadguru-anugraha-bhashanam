#!/bin/sh
# Run the Mac gate before anything leaves this machine. Enabled per clone with
#     git config core.hooksPath .githooks
# Skipping it (git push --no-verify) is possible and should be rare; the
# GitHub workflow runs the site's own half of the checks either way.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec ./check_all.py
